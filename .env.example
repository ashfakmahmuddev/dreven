# MongoDB Atlas connection. Replace <db_password> with the URL-encoded
# password for the `drevenbd_db_user` database user; do not commit .env.local.
MONGODB_URI="mongodb+srv://drevenbd_db_user:<db_password>@dreven-cluster.en36dj5.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="dreven"

# Admin access
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="generate-with-node-crypto"
